{
  "name": "cloud-functions",
  "description": "Firebase Cloud Functions",
  "dependencies": {
    "@langchain/anthropic": "^1.3.29",
    "@langchain/core": "^1.1.45",
    "@langchain/google-genai": "^2.1.30",
    "@langchain/langgraph": "^1.3.0",
    "@langchain/openai": "^1.4.5",
    "@mux/mux-node": "^7.3.3",
    "@onesignal/node-onesignal": "^2.0.1-beta2",
    "axios": "^1.16.0",
    "braintree": "^3.6.0",
    "firebase-admin": "^13.9.0",
    "firebase-functions": "^7.2.5",
    "openai": "^6.37.0",
    "qs": "^6.7.0",
    "razorpay": "^2.8.4",
    "stripe": "^8.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "eslint": "^9.39.4"
  },
  "scripts": {
    "lint": "./node_modules/.bin/eslint --max-warnings=0 .",
    "test:functions": "node --test test/functions.logic.test.js",
    "test:rules": "node --test test/firestore.rules.test.js",
    "serve": "firebase -P roast-nutri-tracker-7c67ct emulators:start --only functions",
    "shell": "firebase -P roast-nutri-tracker-7c67ct functions:shell",
    "start": "npm run shell",
    "logs": "firebase -P roast-nutri-tracker-7c67ct functions:log",
    "compile": "cp ../../tsconfig.template.json ./tsconfig-compile.json && tsc --project tsconfig-compile.json"
  },
  "engines": {
    "node": "22"
  },
  "private": true
}
